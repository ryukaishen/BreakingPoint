diff --git a/src/data/draft.ts b/src/data/draft.ts
new file mode 100644
index 0000000..ac9dfd3
--- /dev/null
+++ b/src/data/draft.ts
@@ -0,0 +1,161 @@
+// Recovery drafts for live work interrupted by a refresh, crash, or closed tab.
+//
+// Browser unload handlers are not reliable, so a live set is checkpointed after
+// every rep. If the page disappears, the next visit offers the reps that really
+// were measured. Nothing is estimated: a draft is a SessionRecord built from the
+// engine's own output at the last checkpoint.
+//
+// Integrity rules:
+//  - Live sets only. Demo and sample data never get a draft.
+//  - An interrupted set is saved as an ordinary set in the athlete's history but is
+//    marked not eligible, so it can never set a record, raise a milestone's record
+//    count, or be used as a comparison. (It is real training, so it still shows in
+//    history and counts as a training day.)
+//  - Drafts are untrusted input: localStorage can be edited or corrupted, so every
+//    field is validated and unknown fields are dropped before anything is saved.
+
+import { readJson, writeJson, type KeyValueStore } from './kv';
+import { SCHEMA_VERSION, type SessionRecord } from './types';
+
+export const DRAFT_PREFIX = 'bp.v2.draft.';
+export const draftKey = (athleteId: string): string => DRAFT_PREFIX + athleteId;
+
+export const INTERRUPTED_REASON = 'Interrupted before the set ended';
+const MAX_REPS = 500;
+
+/** A monitored set that was in progress. */
+export interface SetDraft {
+  v: 1;
+  kind: 'set';
+  savedAt: string;
+  record: SessionRecord;
+}
+
+/** A calibration that was in progress. Nothing to restore (the baseline never locked); kept only so the athlete is told. */
+export interface CalibrationDraft {
+  v: 1;
+  kind: 'calibration';
+  savedAt: string;
+  athleteId: string;
+  protocolId: string;
+  /** Calibration reps captured before the interruption. */
+  reps: number;
+}
+
+export type Draft = SetDraft | CalibrationDraft;
+
+// ---------------------------------------------------------------- validation
+const isObj = (x: unknown): x is Record<string, unknown> => typeof x === 'object' && x !== null && !Array.isArray(x);
+const str = (x: unknown, max = 200): x is string => typeof x === 'string' && x.length > 0 && x.length <= max;
+const num = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x);
+const numOrNull = (x: unknown): boolean => x === null || num(x);
+const int = (x: unknown, min = 0): x is number => typeof x === 'number' && Number.isInteger(x) && x >= min;
+const iso = (x: unknown): x is string => str(x, 40) && !Number.isNaN(Date.parse(x));
+const STATES = ['STABLE', 'DRIFT', 'BREAKPOINT'];
+
+function validRep(r: unknown): boolean {
+  return (
+    isObj(r) &&
+    int(r.index, 1) &&
+    numOrNull(r.score) &&
+    (r.state === null || (typeof r.state === 'string' && STATES.includes(r.state))) &&
+    numOrNull(r.ewma) &&
+    num(r.quality) &&
+    r.quality >= 0 &&
+    r.quality <= 1 &&
+    typeof r.afterWarning === 'boolean'
+  );
+}
+
+function validRecord(rec: unknown): rec is SessionRecord {
+  if (!isObj(rec)) return false;
+  if (rec.schemaVersion !== SCHEMA_VERSION || rec.source !== 'live') return false;
+  if (![rec.id, rec.athleteId, rec.sportId, rec.protocolId, rec.exercise, rec.detectorConfigId].every((x) => str(x))) return false;
+  if (![rec.startedAt, rec.endedAt, rec.baselineSavedAt].every(iso)) return false;
+  if (!Array.isArray(rec.reps) || rec.reps.length < 1 || rec.reps.length > MAX_REPS || !rec.reps.every(validRep)) return false;
+  if (rec.totalReps !== rec.reps.length || !int(rec.scoredReps) || rec.scoredReps > rec.reps.length) return false;
+  if (!int(rec.heldReps) || rec.heldReps > rec.reps.length) return false;
+  if (!(rec.onsetRep === null || int(rec.onsetRep, 1)) || !(rec.breakpointRep === null || int(rec.breakpointRep, 1))) return false;
+  const cal = rec.calibration;
+  if (!isObj(cal) || typeof cal.ok !== 'boolean' || !num(cal.nReps) || !num(cal.sigma0) || !Array.isArray(cal.reasons)) return false;
+  const q = rec.quality;
+  if (!isObj(q) || typeof q.eligible !== 'boolean' || !Array.isArray(q.reasons) || !q.reasons.every((x) => typeof x === 'string')) return false;
+  return Array.isArray(rec.topChanges);
+}
+
+/** Validate untrusted JSON as a draft; null when anything is off. */
+export function parseDraft(raw: unknown): Draft | null {
+  if (!isObj(raw) || raw.v !== 1 || !iso(raw.savedAt)) return null;
+  if (raw.kind === 'set') return validRecord(raw.record) ? { v: 1, kind: 'set', savedAt: raw.savedAt, record: raw.record } : null;
+  if (raw.kind === 'calibration' && str(raw.athleteId) && str(raw.protocolId) && int(raw.reps)) {
+    return { v: 1, kind: 'calibration', savedAt: raw.savedAt, athleteId: raw.athleteId, protocolId: raw.protocolId, reps: raw.reps };
+  }
+  return null;
+}
+
+export const draftAthleteId = (d: Draft): string => (d.kind === 'set' ? d.record.athleteId : d.athleteId);
+
+// ---------------------------------------------------------------- storage
+/** One draft per athlete: the newest checkpoint replaces the last. */
+export function saveDraft(kv: KeyValueStore, d: Draft): boolean {
+  return writeJson(kv, draftKey(draftAthleteId(d)), d);
+}
+
+/** The athlete's draft, or null. A corrupt or tampered entry is removed so it cannot block recovery forever. */
+export function loadDraft(kv: KeyValueStore, athleteId: string): Draft | null {
+  const key = draftKey(athleteId);
+  const raw = readJson<unknown>(kv, key);
+  if (raw === null) {
+    if (kv.get(key) !== null) kv.remove(key); // present but not JSON
+    return null;
+  }
+  const d = parseDraft(raw);
+  if (!d || draftAthleteId(d) !== athleteId) {
+    kv.remove(key);
+    return null;
+  }
+  return d;
+}
+
+export function clearDraft(kv: KeyValueStore, athleteId: string): void {
+  kv.remove(draftKey(athleteId));
+}
+
+/** Every valid draft on this device (one per athlete), oldest first. */
+export function listDrafts(kv: KeyValueStore): Draft[] {
+  const out: Draft[] = [];
+  for (const key of kv.keys()) {
+    if (!key.startsWith(DRAFT_PREFIX)) continue;
+    const d = loadDraft(kv, key.slice(DRAFT_PREFIX.length));
+    if (d) out.push(d);
+  }
+  return out.sort((a, b) => a.savedAt.localeCompare(b.savedAt));
+}
+
+// ---------------------------------------------------------------- recovery
+const RECORD_KEYS: (keyof SessionRecord)[] = [
+  'schemaVersion', 'id', 'athleteId', 'source', 'sportId', 'subSportId', 'protocolId', 'exercise', 'detectorConfigId', 'startedAt', 'endedAt',
+  'baselineSavedAt', 'calibration', 'reps', 'totalReps', 'scoredReps', 'heldReps', 'onsetRep', 'breakpointRep', 'avgPre', 'avgPost', 'topChanges',
+  'patternId', 'recovery', 'quality',
+];
+
+/**
+ * The record to store when the athlete chooses to keep an interrupted set.
+ * Ends at the last checkpoint, carries no recovery check, and is never eligible for records.
+ */
+export function interruptedRecord(d: SetDraft): SessionRecord {
+  const src = d.record as unknown as Record<string, unknown>;
+  const clean: Record<string, unknown> = {};
+  for (const k of RECORD_KEYS) if (src[k] !== undefined) clean[k] = src[k];
+  const rec = clean as unknown as SessionRecord;
+  return {
+    ...rec,
+    endedAt: d.savedAt,
+    recovery: null,
+    quality: {
+      ...rec.quality,
+      eligible: false,
+      reasons: rec.quality.reasons.includes(INTERRUPTED_REASON) ? rec.quality.reasons : [...rec.quality.reasons, INTERRUPTED_REASON],
+    },
+  };
+}
diff --git a/src/session/announce.ts b/src/session/announce.ts
new file mode 100644
index 0000000..dc79ade
--- /dev/null
+++ b/src/session/announce.ts
@@ -0,0 +1,54 @@
+// What a screen reader should hear as a session moves along.
+//
+// Quiet by default: nothing is announced per rep or per frame, because a live
+// region that rewrites itself every rep turns a calm workout into a stream of
+// interruptions. Only phase changes and the first drift are spoken politely.
+// The breaking point is the single assertive message, because it is the one
+// instruction that must interrupt: stop and rest.
+
+import { heldReps } from '../data/progress';
+import { RECOVERY_REPS, type Snapshot } from './engine';
+
+export interface Announcement {
+  polite: string | null;
+  /** Reserved for the breaking point. */
+  assertive: string | null;
+}
+
+const NONE: Announcement = { polite: null, assertive: null };
+const polite = (text: string): Announcement => ({ polite: text, assertive: null });
+
+export function announce(prev: Snapshot | null, next: Snapshot): Announcement {
+  if (!prev || prev === next) return NONE;
+
+  if (prev.alarmRep === null && next.alarmRep !== null) {
+    return { polite: null, assertive: `Stop. Breaking point at rep ${next.alarmRep}. End the set and rest.` };
+  }
+
+  if (prev.phase !== next.phase) {
+    switch (next.phase) {
+      case 'calibrating':
+        return polite(`Calibration started. Perform ${next.calibrationTarget} controlled reps at your normal tempo.`);
+      case 'baseline':
+        return polite('Baseline locked.');
+      case 'monitoring':
+        return polite('Set started.');
+      case 'summary': {
+        if (next.alarmRep !== null) return polite(`Set ended. The breaking point was at rep ${next.alarmRep}. Rest, then run the recovery check.`);
+        const held = heldReps(next.monitorReps);
+        return polite(`Set ended. ${next.monitorReps.length} reps, ${held} held at your baseline.`);
+      }
+      case 'recovery':
+        return polite(`Recovery check started. Perform ${RECOVERY_REPS} controlled reps.`);
+      case 'recoveryDone':
+        return polite(next.recovery ? `Recovery check complete. ${Math.round(next.recovery.percent * 100)} percent back toward your baseline.` : 'Recovery check complete.');
+      default:
+        return NONE;
+    }
+  }
+
+  if (next.phase === 'monitoring' && prev.state === 'STABLE' && next.state === 'DRIFT') {
+    return polite('Your movement is drifting from your baseline. Be ready to stop.');
+  }
+  return NONE;
+}
diff --git a/src/session/navGuard.ts b/src/session/navGuard.ts
new file mode 100644
index 0000000..3174d52
--- /dev/null
+++ b/src/session/navGuard.ts
@@ -0,0 +1,160 @@
+// Keeps the browser's history in step with the app's three views, and protects
+// live work in progress from an accidental Back, refresh or close.
+//
+// What can and cannot be guaranteed:
+//  - Back / Forward: fully intercepted. A protected Back is undone, the athlete is
+//    asked, and the navigation is replayed only if they confirm.
+//  - Refresh / close: `beforeunload` asks the browser to show its own prompt. Browsers
+//    may ignore it (mobile browsers, no recent user interaction, crashes, tab discard),
+//    so it is only a speed bump. The real safety net is `persist`, called whenever the
+//    page is hidden or unloading, which writes a recoverable draft.
+//
+// The controller takes its window and handlers as arguments so it can be tested
+// without a browser.
+
+export type NavView = 'landing' | 'sport' | 'session';
+
+interface Entry {
+  view: NavView;
+  /** Position in the history stack, so a multi-step jump can be undone exactly. */
+  pos: number;
+}
+
+export interface HistoryLike {
+  readonly state: unknown;
+  pushState(data: unknown, unused: string, url?: string | null): void;
+  replaceState(data: unknown, unused: string, url?: string | null): void;
+  go(delta: number): void;
+}
+
+export interface GuardEnv {
+  win: {
+    readonly history: HistoryLike;
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    addEventListener(type: string, listener: (e: any) => void): void;
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    removeEventListener(type: string, listener: (e: any) => void): void;
+  };
+  doc: {
+    readonly visibilityState: string;
+    addEventListener(type: string, listener: () => void): void;
+    removeEventListener(type: string, listener: () => void): void;
+  };
+}
+
+export interface NavGuardHandlers {
+  /** The view the app is showing right now. */
+  getView(): NavView;
+  /** Move the app to a view (only called for Back/Forward the guard allows). */
+  setView(view: NavView): void;
+  /** True while leaving would throw away live work: calibrating, monitoring or a recovery check in a live set. */
+  isProtected(): boolean;
+  /** Ask the athlete. `proceed` must be called only if they confirm. */
+  requestLeave(proceed: () => void): void;
+  /** Write recoverable state now. Called when the page is hidden or unloading. */
+  persist(): void;
+}
+
+export interface NavGuard {
+  /** Tell the guard the app moved to `view` (call after every view change). */
+  sync(view: NavView): void;
+  dispose(): void;
+}
+
+const VIEWS: readonly string[] = ['landing', 'sport', 'session'];
+
+function parse(state: unknown): Entry | null {
+  const bp = (state as { bp?: { view?: unknown; pos?: unknown } } | null)?.bp;
+  if (!bp || typeof bp.view !== 'string' || !VIEWS.includes(bp.view)) return null;
+  if (typeof bp.pos !== 'number' || !Number.isInteger(bp.pos) || bp.pos < 0) return null;
+  return { view: bp.view as NavView, pos: bp.pos };
+}
+
+export function createNavGuard(env: GuardEnv, h: NavGuardHandlers): NavGuard {
+  const { win, doc } = env;
+  const hist = win.history;
+  let view = h.getView();
+  // After a reload the browser keeps the old entry's state: reuse its position, never its view
+  // (a reloaded page cannot resume a session).
+  let pos = parse(hist.state)?.pos ?? 0;
+  hist.replaceState({ bp: { view, pos } }, '');
+
+  /** The position we asked the browser to return to while the athlete decides. */
+  let undoTo: number | null = null;
+  /** Set once the athlete confirmed, so the replayed navigation is not blocked a second time. */
+  let allowLeave = false;
+
+  const onPopState = (e: { state: unknown }) => {
+    const st = parse(e.state);
+    if (!st) return; // an entry this app did not create: leave it to the browser
+    if (undoTo !== null && st.pos === undoTo) {
+      // Our own undo landed. Stay where we were.
+      undoTo = null;
+      pos = st.pos;
+      return;
+    }
+    const from = pos;
+    pos = st.pos;
+    if (st.view === 'session' && view !== 'session') {
+      // Forward onto a session that no longer exists: turn the dead entry into the current view.
+      hist.replaceState({ bp: { view, pos } }, '');
+      return;
+    }
+    if (st.view === view) return;
+    if (h.isProtected() && !allowLeave) {
+      const target = st.pos;
+      undoTo = from;
+      hist.go(from - target);
+      h.requestLeave(() => {
+        allowLeave = true;
+        hist.go(target - from);
+      });
+      return;
+    }
+    allowLeave = false;
+    h.setView(st.view);
+  };
+
+  const onBeforeUnload = (e: { preventDefault(): void; returnValue?: unknown }) => {
+    if (!h.isProtected()) return;
+    h.persist();
+    e.preventDefault();
+    e.returnValue = ''; // Chromium needs this to show its prompt
+  };
+  const onPageHide = () => h.persist();
+  const onVisibility = () => {
+    if (doc.visibilityState === 'hidden') h.persist();
+  };
+
+  win.addEventListener('popstate', onPopState);
+  win.addEventListener('beforeunload', onBeforeUnload);
+  win.addEventListener('pagehide', onPageHide);
+  doc.addEventListener('visibilitychange', onVisibility);
+
+  return {
+    sync(next) {
+      if (next === view) return;
+      const prev = view;
+      view = next;
+      const cur = parse(hist.state);
+      if (cur && cur.view === next) {
+        // Back or Forward already put the browser here.
+        pos = cur.pos;
+        return;
+      }
+      if (prev === 'session') {
+        // A finished session is not a place to come back to: replace its entry instead of stacking on it.
+        hist.replaceState({ bp: { view: next, pos } }, '');
+      } else {
+        pos += 1;
+        hist.pushState({ bp: { view: next, pos } }, '');
+      }
+    },
+    dispose() {
+      win.removeEventListener('popstate', onPopState);
+      win.removeEventListener('beforeunload', onBeforeUnload);
+      win.removeEventListener('pagehide', onPageHide);
+      doc.removeEventListener('visibilitychange', onVisibility);
+    },
+  };
+}
diff --git a/src/session/useNavGuard.ts b/src/session/useNavGuard.ts
new file mode 100644
index 0000000..7077c08
--- /dev/null
+++ b/src/session/useNavGuard.ts
@@ -0,0 +1,42 @@
+import { useEffect, useRef } from 'react';
+import { createNavGuard, type NavGuard, type NavView } from './navGuard';
+
+interface Args {
+  view: NavView;
+  setView: (view: NavView) => void;
+  /** True while leaving would throw away live work. */
+  isProtected: boolean;
+  /** Ask the athlete (and end the set if they agree) before `proceed` runs. */
+  requestLeave: (proceed: () => void) => void;
+  /** Write a recovery draft now. */
+  persist: () => void;
+}
+
+/** Wires the browser Back/Forward/refresh/close protection (see navGuard.ts) to the app's view state. */
+export function useNavGuard(a: Args): void {
+  const latest = useRef(a);
+  latest.current = a;
+  const guard = useRef<NavGuard | null>(null);
+
+  useEffect(() => {
+    const g = createNavGuard(
+      { win: window, doc: document },
+      {
+        getView: () => latest.current.view,
+        setView: (v) => latest.current.setView(v),
+        isProtected: () => latest.current.isProtected,
+        requestLeave: (proceed) => latest.current.requestLeave(proceed),
+        persist: () => latest.current.persist(),
+      },
+    );
+    guard.current = g;
+    return () => {
+      g.dispose();
+      guard.current = null;
+    };
+  }, []);
+
+  useEffect(() => {
+    guard.current?.sync(a.view);
+  }, [a.view]);
+}
diff --git a/src/session/useSetDraft.ts b/src/session/useSetDraft.ts
new file mode 100644
index 0000000..47f200f
--- /dev/null
+++ b/src/session/useSetDraft.ts
@@ -0,0 +1,92 @@
+// Checkpoints a live set (and an unfinished calibration) so an accidental refresh,
+// crash or closed tab does not lose the reps that were measured. See data/draft.ts
+// for the integrity rules. Demo and sample sessions never write drafts.
+
+import { useCallback, useEffect, useRef } from 'react';
+import { calibrationQuality } from '../data/quality';
+import { clearDraft, saveDraft } from '../data/draft';
+import type { KeyValueStore } from '../data/kv';
+import { newId } from '../data/repository';
+import { buildSessionRecord } from '../data/sessionRecord';
+import type { DetectorConfig } from '../detection/config';
+import type { LaunchContext } from '../protocols/launch';
+import type { Snapshot } from './engine';
+import { buildSummary } from './summary';
+
+interface Args {
+  snap: Snapshot;
+  mode: 'demo' | 'live';
+  kv: KeyValueStore;
+  /** False when browser storage is unavailable (nothing can be saved). */
+  persistent: boolean;
+  athleteId: string | null;
+  launch: LaunchContext;
+  config: DetectorConfig;
+  /** True while the session screen is showing. Leaving it on purpose clears this run's draft. */
+  active: boolean;
+  /** True while an earlier interrupted set is waiting for a decision: do not overwrite it. */
+  blocked: boolean;
+}
+
+export function useSetDraft(a: Args): { flush: () => void } {
+  const latest = useRef(a);
+  latest.current = a;
+  const startedAt = useRef<string | null>(null);
+  const setId = useRef<string | null>(null);
+  /** The athlete whose draft THIS page load wrote. Drafts from earlier loads are never touched here. */
+  const wrote = useRef<string | null>(null);
+
+  const flush = useCallback(() => {
+    const x = latest.current;
+    const s = x.snap;
+    if (x.mode !== 'live' || !x.persistent || !x.athleteId || x.blocked) return;
+    const now = new Date().toISOString();
+    if (s.phase === 'monitoring' && s.baseline && s.monitorReps.length > 0 && startedAt.current && setId.current) {
+      const summary = buildSummary(s.monitorReps, s.exercise, s.athlete, s.alarmRep, s.onsetRep);
+      const record = buildSessionRecord({
+        id: setId.current,
+        snap: { ...s, summary },
+        ctx: x.launch,
+        athleteId: x.athleteId,
+        source: 'live',
+        config: x.config,
+        startedAt: startedAt.current,
+        endedAt: now,
+        baselineSavedAt: s.baseline.createdAt,
+        calibration: calibrationQuality(s.baseline, x.config),
+      });
+      if (saveDraft(x.kv, { v: 1, kind: 'set', savedAt: now, record })) wrote.current = x.athleteId;
+    } else if (s.phase === 'calibrating' && s.calibrationReps.length > 0) {
+      if (saveDraft(x.kv, { v: 1, kind: 'calibration', savedAt: now, athleteId: x.athleteId, protocolId: x.launch.protocol.id, reps: s.calibrationReps.length })) {
+        wrote.current = x.athleteId;
+      }
+    }
+  }, []);
+
+  const drop = useCallback(() => {
+    if (!wrote.current) return;
+    clearDraft(latest.current.kv, wrote.current);
+    wrote.current = null;
+  }, []);
+
+  // A set begins when monitoring starts.
+  const phase = a.snap.phase;
+  useEffect(() => {
+    if (phase === 'monitoring') {
+      startedAt.current = new Date().toISOString();
+      setId.current = newId('set');
+    }
+  }, [phase]);
+
+  // Checkpoint after every rep and at every phase boundary.
+  useEffect(() => {
+    flush();
+  }, [flush, phase, a.snap.monitorReps.length, a.snap.calibrationReps.length, a.snap.alarmRep]);
+
+  // The set or calibration ended normally (the recorder has saved it) or the athlete left on purpose.
+  useEffect(() => {
+    if ((phase !== 'monitoring' && phase !== 'calibrating') || !a.active) drop();
+  }, [phase, a.active, drop]);
+
+  return { flush };
+}
diff --git a/tests/a11y_css.test.ts b/tests/a11y_css.test.ts
new file mode 100644
index 0000000..937e16c
--- /dev/null
+++ b/tests/a11y_css.test.ts
@@ -0,0 +1,152 @@
+// Static accessibility guards that hold for any palette: the 11px text floor,
+// text contrast of the core tokens on the surfaces they are used on, and the
+// page-level settings the web-interface audit checks. They fail with file:line
+// so a regression names its cause.
+import { describe, expect, it } from 'vitest';
+import { readdirSync, readFileSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+
+// Audit another checkout read-only with BP_ROOT=<path>; defaults to this one.
+const ROOT = process.env.BP_ROOT ?? '.';
+const at = (p: string) => join(ROOT, p);
+
+const walk = (dir: string, ext: string[]): string[] =>
+  readdirSync(dir).flatMap((f) => {
+    const p = join(dir, f);
+    return statSync(p).isDirectory() ? walk(p, ext) : ext.some((e) => p.endsWith(e)) ? [p] : [];
+  });
+
+const stripComments = (s: string) => s.replace(/\/\*[\s\S]*?\*\//g, (m) => m.replace(/[^\n]/g, ' '));
+
+// ---------------------------------------------------------------- text size floor
+const FLOOR_PX = 11;
+
+/** The smallest px value a font-size declaration can produce, or null when it is not a plain px / clamp(px, …). */
+function minPx(value: string): number | null {
+  const v = value.trim();
+  const plain = /^([\d.]+)px$/.exec(v);
+  if (plain) return Number(plain[1]);
+  const clamp = /^clamp\(\s*([\d.]+)px\s*,/.exec(v);
+  return clamp ? Number(clamp[1]) : null;
+}
+
+describe('text size floor', () => {
+  it(`no CSS declares text smaller than ${FLOOR_PX}px`, () => {
+    const bad: string[] = [];
+    for (const file of walk(at('src'), ['.css'])) {
+      stripComments(readFileSync(file, 'utf8'))
+        .split('\n')
+        .forEach((line, i) => {
+          for (const m of line.matchAll(/(?:^|[;{\s])font-size:\s*([^;}]+)/g)) {
+            const px = minPx(m[1]);
+            if (px !== null && px < FLOOR_PX) bad.push(`${file.replace(/\\/g, '/')}:${i + 1} font-size ${m[1].trim()}`);
+          }
+        });
+    }
+    expect(bad, `Informational text must be at least ${FLOOR_PX}px:\n${bad.join('\n')}`).toEqual([]);
+  });
+
+  it(`no SVG or inline text in TSX is smaller than ${FLOOR_PX}px`, () => {
+    const bad: string[] = [];
+    for (const file of walk(at('src'), ['.tsx'])) {
+      readFileSync(file, 'utf8')
+        .split('\n')
+        .forEach((line, i) => {
+          for (const m of line.matchAll(/fontSize[=:]\s*\{?\s*([\d.]+)/g)) if (Number(m[1]) < FLOOR_PX) bad.push(`${file.replace(/\\/g, '/')}:${i + 1} fontSize ${m[1]}`);
+        });
+    }
+    expect(bad, bad.join('\n')).toEqual([]);
+  });
+});
+
+// ---------------------------------------------------------------- token contrast
+function rootTokens(css: string): Map<string, string> {
+  const body = /:root\s*\{([\s\S]*?)\n\}/.exec(stripComments(css))?.[1] ?? '';
+  const out = new Map<string, string>();
+  for (const m of body.matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)) out.set(m[1], m[2].trim());
+  return out;
+}
+
+function resolveHex(tokens: Map<string, string>, name: string, depth = 0): string {
+  const raw = tokens.get(name);
+  if (raw === undefined) throw new Error(`token ${name} is not defined in :root`);
+  const ref = /^var\((--[\w-]+)\)$/.exec(raw);
+  if (ref) {
+    if (depth > 5) throw new Error(`token ${name} is circular`);
+    return resolveHex(tokens, ref[1], depth + 1);
+  }
+  const hex = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i.exec(raw);
+  if (!hex) throw new Error(`token ${name} is not a plain hex colour (${raw})`);
+  const h = hex[1].length === 3 ? [...hex[1]].map((c) => c + c).join('') : hex[1];
+  return h.toLowerCase();
+}
+
+const lin = (c: number) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
+const lum = (hex: string) => {
+  const [r, g, b] = [0, 2, 4].map((i) => lin(parseInt(hex.slice(i, i + 2), 16) / 255));
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+};
+const contrast = (a: string, b: string) => {
+  const [hi, lo] = [lum(a), lum(b)].sort((x, y) => y - x);
+  return (hi + 0.05) / (lo + 0.05);
+};
+
+describe('token contrast (WCAG 2.1 AA)', () => {
+  const tokens = rootTokens(readFileSync(at('src/styles.css'), 'utf8'));
+  const c = (n: string) => resolveHex(tokens, `--${n}`);
+  const surfaces = ['void', 'abyss', 'panel', 'panel-2'];
+
+  it.each([['text'], ['text-2'], ['muted']])('%s reads at 4.5:1 on every surface text sits on', (fg) => {
+    for (const bg of surfaces) {
+      const ratio = contrast(c(fg), c(bg));
+      expect(ratio, `--${fg} on --${bg} is ${ratio.toFixed(2)}:1`).toBeGreaterThanOrEqual(4.5);
+    }
+  });
+
+  // The accent that is used as TEXT: the light cobalt in Breakaway (the base cobalt is a fill), the electric blue before it.
+  const accentText = tokens.has('--cobalt-hi') ? 'cobalt-hi' : 'sys';
+  it.each([['stable'], ['drift'], ['break'], [accentText], ['ice']])('state and accent colour --%s is legible as text on panels', (fg) => {
+    for (const bg of ['void', 'panel']) {
+      const ratio = contrast(c(fg), c(bg));
+      expect(ratio, `--${fg} on --${bg} is ${ratio.toFixed(2)}:1`).toBeGreaterThanOrEqual(4.5);
+    }
+  });
+
+  // Text that sits ON a filled colour must use the pairing the palette declares for it.
+  const fills = [['on-cobalt', 'cobalt'], ['on-lime', 'lime'], ['on-sys', 'sys']].filter(([fg, bg]) => tokens.has('--' + fg) && tokens.has('--' + bg));
+  it.each(fills)('--%s on --%s reaches 4.5:1', (fg, bg) => {
+    const ratio = contrast(c(fg), c(bg));
+    expect(ratio, `--${fg} on --${bg} is ${ratio.toFixed(2)}:1`).toBeGreaterThanOrEqual(4.5);
+  });
+
+  it('borders that mark a control are visible (3:1 against the surface they sit on)', () => {
+    // Informational: hairlines (--line) are decorative; control outlines (--line-2) are not required to reach 3:1
+    // because every control also has a filled background or a text label. This guards against the outline vanishing.
+    expect(contrast(c('line-2'), c('panel'))).toBeGreaterThan(1.3);
+  });
+});
+
+// ---------------------------------------------------------------- page-level settings
+describe('page-level settings', () => {
+  const html = readFileSync(at('index.html'), 'utf8');
+  const css = readFileSync(at('src/styles.css'), 'utf8');
+
+  it('does not disable zoom', () => {
+    expect(html).not.toMatch(/user-scalable\s*=\s*(no|0)/i);
+    expect(html).not.toMatch(/maximum-scale\s*=\s*1(\.0)?\b/i);
+  });
+
+  it('declares a dark colour scheme and a matching theme colour', () => {
+    expect(css).toMatch(/color-scheme:\s*dark/);
+    expect(html).toMatch(/<meta\s+name="theme-color"/);
+  });
+
+  it('has a skip link and a focus-visible ring', () => {
+    expect(css).toMatch(/\.skip-link/);
+    expect(css).toMatch(/:focus-visible/);
+  });
+
+  it('never uses transition: all', () => {
+    expect(stripComments(css)).not.toMatch(/transition:\s*all\b/);
+  });
+});
diff --git a/tests/announce.test.ts b/tests/announce.test.ts
new file mode 100644
index 0000000..b1be13c
--- /dev/null
+++ b/tests/announce.test.ts
@@ -0,0 +1,77 @@
+// Screen-reader announcements: quiet per rep, polite for progress, assertive only for the stop instruction.
+import { describe, expect, it } from 'vitest';
+import { DEFAULT_DETECTOR_CONFIG } from '../src/detection/config';
+import { SessionEngine, type SessionPhase, type Snapshot } from '../src/session/engine';
+import { announce } from '../src/session/announce';
+
+const base = (): Snapshot => new SessionEngine('squat', DEFAULT_DETECTOR_CONFIG, 'Avery', 'live').getSnapshot();
+const rep = (index: number, state: 'STABLE' | 'DRIFT' | 'BREAKPOINT') =>
+  ({ index, context: 'monitoring', quality: 0.9, drift: { score: 0.5 }, step: { state } }) as unknown as Snapshot['monitorReps'][number];
+const snapAt = (phase: SessionPhase, over: Partial<Snapshot> = {}): Snapshot => ({ ...base(), phase, ...over });
+
+describe('announcements', () => {
+  it('say nothing without a previous snapshot or when nothing changed', () => {
+    const s = snapAt('monitoring');
+    expect(announce(null, s)).toEqual({ polite: null, assertive: null });
+    expect(announce(s, s)).toEqual({ polite: null, assertive: null });
+  });
+
+  it('stay silent for every rep while movement is stable', () => {
+    let prev = snapAt('monitoring', { monitorReps: [] });
+    for (let i = 1; i <= 12; i++) {
+      const next = { ...prev, monitorReps: [...prev.monitorReps, rep(i, 'STABLE')], version: prev.version + 1 };
+      expect(announce(prev, next)).toEqual({ polite: null, assertive: null });
+      prev = next;
+    }
+  });
+
+  it('say the first drift once, politely', () => {
+    const prev = snapAt('monitoring', { state: 'STABLE', monitorReps: [rep(1, 'STABLE')] });
+    const drift = snapAt('monitoring', { state: 'DRIFT', monitorReps: [rep(1, 'STABLE'), rep(2, 'DRIFT')] });
+    const a = announce(prev, drift);
+    expect(a.polite).toMatch(/drifting/i);
+    expect(a.assertive).toBeNull();
+    const again = snapAt('monitoring', { state: 'DRIFT', monitorReps: [...drift.monitorReps, rep(3, 'DRIFT')] });
+    expect(announce(drift, again)).toEqual({ polite: null, assertive: null });
+  });
+
+  it('make the breaking point the single assertive message, with the rep and what to do', () => {
+    const prev = snapAt('monitoring', { state: 'DRIFT', alarmRep: null });
+    const next = snapAt('monitoring', { state: 'BREAKPOINT', alarmRep: 11 });
+    const a = announce(prev, next);
+    expect(a.assertive).toBe('Stop. Breaking point at rep 11. End the set and rest.');
+    expect(a.polite).toBeNull();
+    // and not again on the next rep
+    const later = { ...next, monitorReps: [rep(12, 'BREAKPOINT')] };
+    expect(announce(next, later)).toEqual({ polite: null, assertive: null });
+  });
+
+  it('never goes assertive for anything but the breaking point', () => {
+    const phases: SessionPhase[] = ['idle', 'calibrating', 'baseline', 'monitoring', 'summary', 'recovery', 'recoveryDone'];
+    for (const from of phases) {
+      for (const to of phases) {
+        const a = announce(snapAt(from), snapAt(to));
+        expect(a.assertive, `${from} -> ${to}`).toBeNull();
+      }
+    }
+  });
+
+  it('describes phase changes in plain words', () => {
+    expect(announce(snapAt('idle'), snapAt('calibrating')).polite).toMatch(/Calibration started/);
+    expect(announce(snapAt('calibrating'), snapAt('baseline')).polite).toBe('Baseline locked.');
+    expect(announce(snapAt('baseline'), snapAt('monitoring')).polite).toBe('Set started.');
+    expect(announce(snapAt('summary'), snapAt('recovery')).polite).toMatch(/Recovery check started/);
+  });
+
+  it('summarises a finished set, with or without a breaking point', () => {
+    const clean = snapAt('summary', { monitorReps: [rep(1, 'STABLE'), rep(2, 'STABLE'), rep(3, 'DRIFT')] });
+    expect(announce(snapAt('monitoring'), clean).polite).toBe('Set ended. 3 reps, 2 held at your baseline.');
+    const broke = snapAt('summary', { alarmRep: 9 });
+    expect(announce(snapAt('monitoring', { alarmRep: 9 }), broke).polite).toMatch(/breaking point was at rep 9\. Rest, then run the recovery check/);
+  });
+
+  it('reports the recovery result as a whole percent', () => {
+    const done = snapAt('recoveryDone', { recovery: { percent: 0.8349 } as Snapshot['recovery'] });
+    expect(announce(snapAt('recovery'), done).polite).toBe('Recovery check complete. 83 percent back toward your baseline.');
+  });
+});
