+/* Skip link: the first tab stop, visible only while focused. */
+.skip-link {
+  position: absolute; left: 12px; top: -64px; z-index: 100; padding: 10px 16px; border-radius: var(--r-sm);
+  background: var(--panel-2); color: var(--text); border: 1px solid var(--sys); font-weight: 600; text-decoration: none;
+}
+.skip-link:focus { top: 12px; }
+/* <main> is a programmatic focus target for the skip link, not a control: no ring. */
+main:focus { outline: none; }
 
