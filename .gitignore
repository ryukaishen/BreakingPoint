# dependencies / build
node_modules/
dist/
*.tsbuildinfo

# large downloaded runtime assets (re-created by `npm install` / `npm run setup:assets`)
public/mediapipe/
public/models/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Lab outputs: shards and logs are regenerated; keep the curated results
# New Lab runs write to results/runs/<run-name>/ (see hpc/output_guard.py); copy a run out
# deliberately if it should become part of the record.
results/runs/*
!results/runs/README.md

results/shards/
results/logs/
results/robustness_cache/
hpc/logs/*
!hpc/logs/.gitkeep
.venv-hpg/
results_smoke/
slurm-*.out

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# local editor / agent tooling (the pinned audit skill and shared plugin policy are tracked)
.claude/*
!.claude/skills/
!.claude/settings.json
